# /etc/systemd/system/trimimage.service
[Unit]
Description=TrimImage background-removal API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/trimimage/server
Environment="TRIMIMAGE_MODEL=isnet_quint8.onnx"
Environment="TRIMIMAGE_MAX_UPLOAD_MB=12"
Environment="TRIMIMAGE_MAX_EDGE=4000"
# Keep concurrency at or below the core count — inference is CPU-bound.
Environment="TRIMIMAGE_MAX_CONCURRENCY=2"
Environment="TRIMIMAGE_THREADS=2"
ExecStart=/opt/trimimage/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trimimage/server/models

[Install]
WantedBy=multi-user.target
